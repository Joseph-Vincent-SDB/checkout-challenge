{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "$team": {
        ".read": "$team.length == 8",
        "meta": {
          ".write": "$team.length == 8",
          ".validate": "newData.hasChildren(['epoch', 'startStock'])",
          "epoch": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "startStock": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
          },
          "resetAt": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "$other": {
            ".validate": false
          }
        },
        "epochs": {
          "$epoch": {
            ".validate": "$epoch.length >= 1 && $epoch.length <= 24",
            "devices": {
              "$id": {
                ".write": "$team.length == 8 && $id.length >= 6 && $id.length <= 24",
                ".validate": "newData.hasChildren(['c', 'rev', 'hb'])",
                "l": {
                  ".validate": "newData.isString() && newData.val().length <= 24"
                },
                "c": {
                  ".validate": "newData.hasChildren(['customers', 'served'])",
                  "customers": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "follows": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "already": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "correct": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "wrong": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "retries": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "skips": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "hot": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "full": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "won": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "lost": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "served": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "members": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "memberAlready": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "adj": {
                  ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
                },
                "first": {
                  ".validate": "newData.isNumber()"
                },
                "last": {
                  ".validate": "newData.isNumber()"
                },
                "hb": {
                  ".validate": "newData.isNumber()"
                },
                "rev": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
                },
                "app": {
                  ".validate": "newData.isNumber()"
                },
                "cr": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                },
                "ack": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "dk": {
                  ".validate": "newData.isString() && newData.val().length <= 12"
                },
                "bat": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                },
                "chg": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "claims": {
              "$slot": {
                ".write": "$team.length == 8 && $slot.matches(/^[0-9]{1,4}$/) && (!data.exists() || !newData.exists() || data.child('id').val() == newData.child('id').val())",
                ".validate": "newData.hasChildren(['id'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 24"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "ctl": {
          ".write": "$team.length == 8",
          ".validate": "newData.hasChildren(['rev', 'paused', 'locked', 'mem', 'hot', 'retries'])",
          "rev": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000 && (!data.exists() || newData.val() >= data.val())"
          },
          "paused": {
            ".validate": "newData.isBoolean()"
          },
          "locked": {
            ".validate": "newData.isBoolean()"
          },
          "mem": {
            ".validate": "newData.isBoolean()"
          },
          "hot": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "retries": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
          },
          "msg": {
            ".validate": "newData.hasChildren(['id', 't', 'k'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
            },
            "k": {
              ".validate": "newData.isString() && (newData.val() == 'info' || newData.val() == 'warn')"
            },
            "$other": {
              ".validate": false
            }
          },
          "poll": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "keep": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          },
          "qoff": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "hold": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "gone": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "rl": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "log": {
            ".validate": "newData.isString() && newData.val().length <= 800"
          },
          "dm": {
            ".validate": "newData.hasChildren()",
            "$pid": {
              ".validate": "$pid.length >= 6 && $pid.length <= 24 && newData.hasChildren(['id', 't', 'k'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
              },
              "t": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
              },
              "k": {
                ".validate": "newData.isString() && (newData.val() == 'info' || newData.val() == 'warn')"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "admin": {
          ".write": "$team.length == 8",
          ".validate": "newData.hasChildren(['id', 'l', 'hb'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 24"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "hb": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
